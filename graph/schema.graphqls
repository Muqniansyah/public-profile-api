type Hobby {
  id: ID!
  name: String!
}

type Person {
  id: ID!
  name: String!
  age: Int!
  gender: String!
  job: String!
  phone: String!
  email: String!
  address: String!
  city: String!
  country: String!
  hobbies: [Hobby!]!
}

type Query {
  people: [Person!]!
  person(id: ID!): Person
  randomPerson: Person
}
